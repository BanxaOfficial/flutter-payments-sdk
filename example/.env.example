# Copy to .env (gitignored). Load with:
#   flutter run --dart-define-from-file=.env
# Never commit real keys. Do not add .env as a Flutter asset.

BANXA_API_KEY=
BANXA_PARTNER_ID=
BANXA_ENVIRONMENT=sandbox

# Apple Pay (iOS only). Leave blank to disable Apple Pay; without it Primer
# rejects APPLE_PAY and the SDK falls back to hosted checkout. Needs a real
# device plus the matching in-app-payments entitlement in Xcode.
BANXA_APPLE_PAY_MERCHANT_ID=
BANXA_APPLE_PAY_MERCHANT_NAME=
